;;;; prelude.stac: the global names a stac program starts with. Each import binds a namespace's
;;;; words; a different prelude gives a different global namespace (docs/dev/stac.md, Namespaces).

;;;; SuperCollider's UGens, by lower-case class name. clip, fold, wrap, rand, irand and linrand
;;;; stay the core's; sc.clip and the rest reach the UGens.
import sc.*

;;;; stac's standard library, std.stac
import std.*
