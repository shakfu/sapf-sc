;;;; std: stac's standard library, a module (docs/dev/stac.md, Proposal: modules).
;;;; It uses only core words. A prelude makes it global with `import std.*`.


;;;; shortcuts

`clear = c
`cleard = cd
`stop = s

;;;; useful constants

const phi "golden ratio." [5 sqrt 1 + 2 /]

const e "base of the natural logarithm." [1 exp]

const hrt "sqrt(2)/2." [.5 sqrt]

const inf [1 0 /]
const -inf [-1 0 /]
const nan [0 0 /]

const A4 "pitch of A 440 in octaves above 1 Hz." [440 log2]
const C4 "pitch of middle C in octaves above 1 Hz." [A4 9/12 -]
const C4hz "frequency of middle C in Hz." [C4 2^]

const nyq90 "90 percent of nyquist." [nyq .9 *]
const freqLimit "a useful frequency for limiting filter cutoffs." [24k nyq90 &]


const USkb40 ["zxcvbnm,./asdfghjklqwertyuiop1234567890"]
const USkb49 ["zxcvbnm,./~~~asdfghjkl;'~qwertyuiop[]\1234567890-=~"]

"\\n*** printing ***" helpLine

def prall list --> "print every item in a list on a separate line" [list \a [a pr cr] do]

"\\n*** common counts ***" helpLine

def 2X a --> list "a 2 X" [`a 2 X]
def 3X a --> list "a 3 X" [`a 3 X]
def 4X a --> list "a 4 X" [`a 4 X]
def 5X a --> list "a 5 X" [`a 5 X]
def 6X a --> list "a 6 X" [`a 6 X]
def 7X a --> list "a 7 X" [`a 7 X]
def 8X a --> list "a 8 X" [`a 8 X]
def 9X a --> list "a 9 X" [`a 9 X]

def 2XZ a --> list "a 2 XZ" [`a 2 XZ]
def 3XZ a --> list "a 3 XZ" [`a 3 XZ]
def 4XZ a --> list "a 4 XZ" [`a 4 XZ]
def 5XZ a --> list "a 5 XZ" [`a 5 XZ]
def 6XZ a --> list "a 6 XZ" [`a 6 XZ]
def 7XZ a --> list "a 7 XZ" [`a 7 XZ]
def 8XZ a --> list "a 8 XZ" [`a 8 XZ]
def 9XZ a --> list "a 9 XZ" [`a 9 XZ]

def 1N a --> list "keeps the first item of the list a" [a 1 N]
def 2N a --> list "keeps the first 2 items of the list a" [a 2 N]
def 3N a --> list "keeps the first 3 items of the list a" [a 3 N]
def 4N a --> list "keeps the first 4 items of the list a" [a 4 N]
def 5N a --> list "keeps the first 5 items of the list a" [a 5 N]
def 6N a --> list "keeps the first 6 items of the list a" [a 6 N]
def 7N a --> list "keeps the first 7 items of the list a" [a 7 N]
def 8N a --> list "keeps the first 8 items of the list a" [a 8 N]
def 9N a --> list "keeps the first 9 items of the list a" [a 9 N]

def 1N> a --> list "skips the first item of the list a" [a 1 N>]
def 2N> a --> list "skips the first 2 items of the list a" [a 2 N>]
def 3N> a --> list "skips the first 3 items of the list a" [a 3 N>]
def 4N> a --> list "skips the first 4 items of the list a" [a 4 N>]
def 5N> a --> list "skips the first 5 items of the list a" [a 5 N>]
def 6N> a --> list "skips the first 6 items of the list a" [a 6 N>]
def 7N> a --> list "skips the first 7 items of the list a" [a 7 N>]
def 8N> a --> list "skips the first 8 items of the list a" [a 8 N>]
def 9N> a --> list "skips the first 9 items of the list a" [a 9 N>]

def -1s n --> list "returns a stream of n minus ones." [n -1 0 nby]
def 0s n --> list "returns a stream of n zeroes." [n 0 0 nby]
def 1s n --> list "returns a stream of n ones." [n 1 0 nby]
def 2s n --> list "returns a stream of n twos." [n 2 0 nby]

def -1z n --> list "returns a signal of n minus ones." [n -1 0 nbyz]
def 0z n --> list "returns a signal of n zeroes." [n 0 0 nbyz]
def 1z n --> list "returns a signal of n ones." [n 1 0 nbyz]
def 2z n --> list "returns a signal of n twos." [n 2 0 nbyz]

"\\n*** list ops ***" helpLine
def 0at a --> any "get the item at index 0" [a 0 at]
def 1at a --> any "get the item at index 1" [a 1 at]
def 2at a --> any "get the item at index 2" [a 2 at]
def 3at a --> any "get the item at index 3" [a 3 at]
def 4at a --> any "get the item at index 4" [a 4 at]
def 5at a --> any "get the item at index 5" [a 5 at]
def 6at a --> any "get the item at index 6" [a 6 at]
def 7at a --> any "get the item at index 7" [a 7 at]
def 8at a --> any "get the item at index 8" [a 8 at]
def 9at a --> any "get the item at index 9" [a 9 at]

"\\n*** ordinal accessing ***" helpLine
def 1st a --> any "get the first item" [a 0 at]
def 2nd a --> any "get the second item" [a 1 at]
def 3rd a --> any "get the third item" [a 2 at]
def 4th a --> any "get the fourth item" [a 3 at]
def 5th a --> any "get the fifth item" [a 4 at]
def 6th a --> any "get the sixth item" [a 5 at]
def 7th a --> any "get the seventh item" [a 6 at]
def 8th a --> any "get the eighth item" [a 7 at]
def 9th a --> any "get the ninth item" [a 8 at]
def 10th a --> any "get the tenth item" [a 9 at]

def last a --> any
	"get the last value of a. or zero if empty."
	[a size = sz sz 0 == 0 \[a sz -- at] if]

def separate a b --> list list
	"separates the list a such that list c contains all items of a for which b is true and list d contains all items of a for which b is false."
	[a b ? a b ~ ?]
	
def span a b --> list list
	"splits the list a where b first turns false: the leading items of a for which b is true, then the rest."
	[a b keepWhile a b skipWhile]

def runlengths a --> list
	"returns a list of the number of consecutive occurrences of items in the input list."
	[ord a !=^ tail 1 add ? -^]

def divmod a b --> num num "equivalent to ((a b idiv)(a b imod))" [a b idiv a b imod]

"\\n*** each operators ***\\n" helpLine

def each2 a b --> any any "apply the each operator to two items on the stack" [a @ b @]

def each3 a b c --> any any any "apply the each operator to three items on the stack" [a @ b @ c @]

def each4 a b c d --> any any any any
	"apply the each operator to four items on the stack"
	[a @ b @ c @ d @]

def cart2 a b --> any any
	"apply the each operator for a cartesian product to two items on the stack"
	[a @1 b @2]

def cart3 a b c --> any any any
	"apply the each operator for a cartesian product to three items on the stack"
	[a @1 b @2 c @3]

def cart4 a b c d --> any any any any
	"apply the each operator for a cartesian product to four items on the stack"
	[a @1 b @2 c @3 d @4]

def rcart2 a b --> any any
	"apply the each operator for a reverse cartesian product to two items on the stack"
	[a @2 b @1]

def rcart3 a b c --> any any any
	"apply the each operator for a reverse cartesian product to three items on the stack"
	[a @3 b @2 c @1]

def rcart4 a b c d --> any any any any
	"apply the each operator for a reverse cartesian product to four items on the stack"
	[a @4 b @3 c @2 d @1]


"\\n*** list generation ***" helpLine

def nord n --> list "finite stream of counting numbers. equivalent to: ord n N" [n 1 1 nby]

def nordz n --> list "finite signal of counting numbers. equivalent to: ordz n N" [n 1 1 nbyz]

def nnat n --> list "finite stream of counting numbers. equivalent to: nat n N" [n 0 1 nby]

def nnatz n --> list "finite signal of counting numbers. equivalent to: natz n N" [n 0 1 nbyz]

def /X x n --> list
	"divide x by n and make a list repeating that value n times. Useful for tupletizing a duration."
	[ x n / n X]


"\\n*** range mapping ***" helpLine

def MS a b --> sig sig
	"or (M S --> L R) stereo to mid-side conversion. this function is self inverse."
	[a b + hrt * a b - hrt *]

def -+ a b --> sig sig "convert a center and deviation to lo and hi" [a b - a b +]
	
def +- a b --> sig sig "convert a center and deviation to hi and lo" [a b + a b -]

def muldiv a b --> sig sig "return both product and quotient" [a b * a b /]

def divmul a b --> sig sig "return both quotient and product" [a b / a b *]

def cdv lo hi --> sig sig "convert lo and hi to center and deviation" [hi lo avg2 hi lo neg avg2] 


def unilin in lo hi --> sig
	"map a unipolar input to the linear interval [lo, hi]"
	[in hi lo - * lo +]

def unilinc in lo hi --> sig
	"map a unipolar input to the linear interval [lo, hi] clip input to bounds."
	[in 0 1 clip lo hi unilin]

def uniexp in lo hi --> sig
	"map a unipolar input to the exponential interval [lo, hi]"
	[hi lo / in pow lo *]

def uniexpc in lo hi --> sig
	"map a unipolar input to the exponential interval [lo, hi] clip input to bounds."
	[in 0 1 clip lo hi uniexp]

def bilin in lo hi --> sig
	"map a bipolar input to the linear interval [lo, hi]"
	[in biuni lo hi unilin]

def bilinc in lo hi --> sig
	"map a bipolar input to the linear interval [lo, hi] clip input to bounds."
	[in biuni lo hi unilinc]

def biexp in lo hi --> sig
	"map a bipolar input to the exponential interval [lo, hi]"
	[in biuni lo hi uniexp]

def biexpc in lo hi --> sig
	"map a bipolar input to the exponential interval [lo, hi] clip input to bounds."
	[in biuni lo hi uniexpc]

def linlin in a b c d --> sig
	"map a linear interval [a,b] to a linear interval [c,d]."
	[in a - d c - b a - / * c +]
	
def linlinc in a b c d --> sig
	"map a linear interval [a,b] to a linear interval [c,d]. clip input to bounds."
	[in a b clip a b c d linlin]

def linexp in a b c d --> sig
	"map a linear interval [a,b] to an exponential interval [c,d]."
	[d c / in a - b a - / pow c *]

def linexpc in a b c d --> sig
	"map a linear interval [a,b] to an exponential interval [c,d]. clip input to bounds."
	[in a b clip a b c d linexp]

def explin in a b c d --> sig
	"map an exponential interval [a,b] to a linear interval [c,d]."
	[in a / log b a / log / d c - * c +]
	
def explinc in a b c d --> sig
	"map an exponential interval [a,b] to a linear interval [c,d]. clip input to bounds."
	[in a b clip a b c d explin]

def expexp in a b c d --> sig
	"map an exponential interval [a,b] to an exponential interval [c,d]"
	[d c / in a / log b a / log / pow c *]
	
def expexpc in a b c d --> sig
	"map an exponential interval [a,b] to an exponential interval [c,d]. clip input to bounds."
	[in a b clip a b c d expexp]


"\\n*** range checking ***" helpLine

def inrange in lo hi --> sig
	"inclusive range check. return 1 if input is in the interval [lo,hi]."
	[in lo >= in hi <= &]

def exrange in lo hi --> sig
	"exclusive range check. return 1 if input is in the interval (lo,hi)."
	[in lo > in hi < &]


"\\n*** borrowed from APL ***" helpLine

def reshape a s --> list
	"shape is a list of the sizes of each dimension of a matrix into which the input is reshaped."
	[s tail reverse   a flat cyc s */ N  \a b[b a clump] reduce]
	
def iota s --> list "returns a matrix of the positive integers in the given shape." [ord s reshape]


"\\n*** conditional mapping ***" helpLine

def mapif list bools fun --> list
	"apply fun to those values for which the corresponding bool is true. Otherwise pass the value as is."
	[ bools @ list @ \bool item [bool \[item fun]\[item] if] !]


"\\n*** data flow operators ***" helpLine

def abf a b f --> any any "apply a function to top two items. equivalent to: a f b f" [a f b f]

def abcf a b c f --> any any any
	"apply a function to top three items. equivalent to: a f b f c f"
	[a f b f c f]

def afg a f g --> any any "apply two functions to the top item. equivalent to: a f a g" [a f a g]

def afgh a f g h --> any any any
	"apply three functions to the top item. equivalent to: a f a g a h"
	[a f a g a h]

def abfg a b f g --> any any "interleaved application. equivalent to: a f b g" [a f b g]
	
def abcfgh a b c f g h --> any any any
	"interleaved application. equivalent to: a f b g c h"
	[a f b g c h]

def abfg2 a b f g --> any any
	"interleaved application of binary operators. equivalent to: a b f a b g"
	[a b f a b g]

"\\n*** statistics ***" helpLine

def mean a --> num "mean of list a." [a +/ a size /]

def atf a x --> num
	"return the linear interpolated value of list a at position x."
	[x frac  a x floor at  a x ceil at  unilin] 

def median a --> num "median of list a." [a sort a size -- /2 atf]
	
def variance a --> num "variance of list a." [a a mean - sq mean]
	
def deviation a --> num "standard deviation of list a." [a variance sqrt]

def vmag a --> num "vector magnitude of list a." [a sq +/ sqrt]

def fac a --> num "factorial of a" [a ++ tgamma]

"\\n*** numbers ***" helpLine

def factors x --> list "returns a list of the factors of integer x." [x x 1 toz / aa int? ?]

def pfactors x --> list
	"returns a list of the prime factors of integer x."
	[x primez aa x <= keepWhile bab / int? ?]

def coprime a b --> num "test whether numbers  are coprime." [a b gcd 1 ==]

def coprimes a --> num "test whether numbers in list are pairwise coprime." [a */ a lcm/ ==]

"\\n*** unipolar random number generators ***" helpLine
def urand --> num "return a random number from 0 to 1." [0 1 rand]
	
def urands --> list "return a stream of random numbers from 0 to 1." [0 1 rands]
	
def nurands n --> list "return a stream of n random numbers from 0 to 1." [n 0 1 nrands]

"\\n*** bipolar random number generators ***" helpLine
def brand --> num "return a random number from -1 to 1." [1 rand2]
	
def brands --> list "return a stream of random numbers from -1 to 1." [1 rand2s]
	
def nbrands n --> list "return a stream of n random numbers from -1 to 1." [n 1 nrand2s]
	
"\\n*** random walks ***" helpLine

def iwalk step lo hi --> list "integer random walk." [step irand2s +\ lo hi irand + lo hi ifold  ]

def iwalk2 step limit --> list
	"integer random walk. bipolar bounds."
	[step irand2s +\ limit irand2 + limit ifold2  ]

def walk step lo hi --> list "random walk." [step rand2s +\ lo hi rand + lo hi fold  ]

def walk2 step limit --> list
	"random walk. bipolar bounds."
	[step rand2s +\ limit rand2 + limit fold2  ]

"\\n*** composite ugens ***" helpLine

def randsign in --> sig "50% chance of flipping the sign" [.5 coin \[in neg]\[in] if]

def famp freq root expon --> sig
	"frequency dependent amplitude compensation factor."
	[ root freq / expon ^]

"\\n*** amplitude ***" helpLine

def rms in --> num "calculate the rms amplitude. input must be finite." [in sq mean sqrt]

def rmsdb in --> num "calculate the rms amplitude in decibels. input must be finite." [in rms ampdb]
	

"\\n*** complex <-> polar ***" helpLine

def xp x y --> sig sig "complex to polar" [x y hypot y x atan2]

def px r t --> sig sig "polar to complex" [r t cos * r t sin *]

"\\n*** zero padding ***" helpLine
	
def _zeros a n --> list "n zeroes: a signal if a is one, else a list." [a type "ZList" equals \[n 0z] \[0 n X] if]

def padz a n --> list "zero pad after. add n zeroes after list a." [a a n _zeros $]

def zpad a n --> list "zero pad before. add n zeroes before list a." [a n _zeros a $]

def zpadz a n --> list
	"zero pad before and after. add n zeroes before and after list a."
	[a n _zeros = z  z a $ z $]

def nextPow2 a --> num "next power of two greater than or equal to a." [a log2 ceil exp2]

def padzto a n --> list
	"add enough zeroes after list a to make the total size equal to n."
	[a (n a size -) padz]

def dly a t --> list "delay signal a by t seconds." [t mum a $z]

def N/2 a --> list "reduce the length of a stream or signal by half." [a a size /2 N]


"\\n*** dsp functions ***" helpLine

;; sinc function
def sincfill n nz --> list
	"return a sinc (sin(x)/x) wave of size n containing nz zero crossings."
	[ n nz pi * aa neg lindivz sinc]

def sr/ x --> sig "convert from samples to seconds." [x isr *]

def sr* x --> sig "convert from seconds to samples." [x sr *]

def duration a --> num "return the duration of a finite signal." [a size isr *]



"\\n*** normalization ***" helpLine

def normalize x --> list "scale a list so that the peak absolute value is 1." [x abs |/ 1/ x *]

def conormalize x --> list
	"normalize a list of lists with respect to the maximum absolute peak of all of them."
	[x abs @ |/ |/ 1/ x *]
	
def conormalizeb x y --> list
	"normalize to y a list of lists with respect to the maximum absolute peak of all of them."
	[x abs @ |/ |/ 1/ y * x *]

def sumto1 x --> list "scale a list so that its sum is 1." [x x +/ /]

def sumto x y --> list "scale the list x so that its sum is y." [x x +/ / y *]

def absumto x y --> list
	"scale the list x so that the sum of the absolute values is y."
	[x x abs +/ / y *]

def sumcut x y --> list
	"cut the list x so that its sum is y. e.g.  nat pi sumcut ==> [0 1 2 .14159]"
	[x x +\ y < keepWhile inf N = b   b y b +/ - add ]

;;;;;;;

;; a function for checking the fit of an edo tuning.
def predo et -->
	[16 36 to aa log2 frac aa 1200 * ba et * 1 round aa et / 1200 * bac aba - 4ple flop prall]  
;;\et [16 36 to aa log2 frac aa 1000 * ba et * 1 round aa et / 1000 * bac aba - 4ple flop prall] = predo  

def qedo x n --> num "take a ratio and quantize it to n edo." [x log2 n 1/ round 2^] 

def q12 x --> num "take a ratio and quantize it to 12 edo." [x log2 1/12 round 2^] 

def q72 x --> num "take a ratio and quantize it to 72 edo." [x log2 1/72 round 2^] 

def dv x d --> list "add random deviations of amplitude d." [x d rand2s +]

def ldv x d --> list "add deviations of amplitude d in log2 space." [x log2 d rand2s + 2^]

;;;;;;;

"\\n*** 12 tone pitch set operations ***" helpLine

def ps-norm x --> list "pitch set normalization." [x x 1st - 12 %]

def ps-inv x --> list "pitch set mirror inversion." [x neg reverse ps-norm]

def ps-rot x i --> list "return a normalized rotation of a pitch set x." [ x i rot ps-norm]

def ps-rots x --> list
	"return a list of all normalized rotations of a pitch set x."
	[ x 0 x size -- to @ ps-rot]
	
;;;;;;;

"\\n*** pitch operations ***" helpLine

def invert x --> list "mirror inversion. [1 5 4 3] --> [5 1 2 3]" [x |/ x &/ + x -]

def replacehead x v --> list "replace the head of list x with v." [x 1 N> v cons]

def monotonic x m --> list
	"adds multiples of m to elements of x in order to create a monotonic ascending sequence."
	[x <^ 0 replacehead +\ m * x +]


;;;;;;;

"\\n*** rhythm ***" helpLine

def rdiv n p --> list
	"randomly subdivide a total duration of n beats into p durations. n and p must be integers."
	[1 n -- to muss p -- N sort n add -^]

;;;;;;;

"\\n*** list co-length operations ***" helpLine

;; unfortunately the following don't work on indefinite lists that are actually finite. 
;; so these are candidates to be replaced with a built-in.

def shortest x --> list
	"make all lists in list x as short as the shortest list"
	[
		x @ finite |/ 
		\[ x @ cyc @ x @ size &/ N]
		\[ x ] if
	]

def longest x --> list
	"make all lists in list x as long as the longest list via hang"
	[
		x @ finite &/ 
		\[ x @ hang @ x @ size |/ N]
		\[ x @ hang ] if
	]

def cycLongest x --> list
	"make all lists in list x as long as the longest list via cyc"
	[
		x @ finite &/ 
		\[ x @ cyc @ x @ size |/ N]
		\[ x @ cyc ] if
	]

def cyclcm x --> list
	"make all lists in list x as long as the least common multiple of their lengths."
	[
		x @ finite &/ 
		\[ x @ cyc @ x @ size lcm/ N]
		\[ x @ cyc ] if
	]

def mircyc x --> list
	"return a mirrored cycle. i.e. [1 2 3 4] --> [1 2 3 4 3 2 1 2 3 4 3 2...]"
	[ x mirror0 cyc ]


def mirLongest x --> list
	"make all lists in list x as long as the longest list via mircyc"
	[
		x @ finite &/ 
		\[ x @ mircyc @ x @ size |/ N]
		\[ x ] if
	]


