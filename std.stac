;;;;;;;
"\\n*** events ***" helpLine

; { tink :freq 2h 1k xrands @ :dt [.1 .2] picks @ } 1 1 1 ola play

; event list operations

def ev-dur in --> num "return the duration of inEvents." [in.dt +/ ]

def ev-starts in --> list "return a stream of start times for inEvents" [ in.dt 1 shift +\ ]

def ev-end in --> num "return the maximum end time of inEvents." [in ev-starts in.dur + |/ ]

; create an array of reversed start times and then differentiate them.
def ev-reverse in --> list
	"reverse an event list."
	[ {in reverse @ :dt (in ev-dur) (in ev-starts reverse) - -^ @} ]

